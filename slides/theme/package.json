{
  "name": "slidev-theme-ryu",
  "version": "0.1.0",
  "private": true,
  "description": "Shared theme for ryu.engineer slides",
  "keywords": ["slidev-theme", "slidev"],
  "engines": {
    "slidev": ">=0.47.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "colorSchema": "light",
      "transition": "fade",
      "mdc": true,
      "drawings": {
        "persist": false
      },
      "fonts": {
        "sans": "DM Sans",
        "serif": "Noto Serif JP",
        "mono": "IBM Plex Mono"
      }
    }
  }
}
