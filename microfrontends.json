{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "site": {
      "development": {
        "fallback": "www.ryu.engineer",
        "local": 3000
      }
    },
    "slides": {
      "packageName": "slides",
      "routing": [
        {
          "group": "slides",
          "paths": ["/slides", "/slides/:path*"]
        }
      ],
      "development": {
        "local": 3030,
        "task": "dev"
      }
    }
  }
}
